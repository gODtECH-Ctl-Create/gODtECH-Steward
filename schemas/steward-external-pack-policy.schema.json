{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gODtECH-Ctl-Create.github.io/gODtECH-Steward/schemas/steward-external-pack-policy.schema.json",
  "title": "gODtECH Steward External Rule-Pack Trust Policy",
  "description": "Opt-in policy for trusted external rule-pack verification and execution admission. Verification never implies execution admission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requireSigned", "allow", "trustedPublishers", "trustedKeys"],
  "properties": {
    "requireSigned": { "type": "boolean", "default": true },
    "allow": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" }
    },
    "trustedPublishers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" }
    },
    "trustedKeys": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "propertyNames": { "pattern": "^ed25519:[A-Za-z0-9._:-]{3,127}$" }
    },
    "revokedPublishers": {
      "type": "array",
      "uniqueItems": true,
      "default": [],
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" }
    },
    "revokedKeys": {
      "type": "array",
      "uniqueItems": true,
      "default": [],
      "items": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9._:-]{3,127}$" }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "trustedSourceRepositories", "pins"],
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "trustedSourceRepositories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "pins": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "sha256"],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
