{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gODtECH-Ctl-Create/gODtECH-Steward/blob/main/schemas/steward-result.schema.json",
  "title": "gODtECH Steward Scan Result",
  "description": "Versioned machine-readable result emitted by gODtECH Steward.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "version",
    "root",
    "scannedFiles",
    "textFiles",
    "findings",
    "healthScore",
    "durationMs",
    "git",
    "categoryCounts",
    "ruleCounts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": { "const": "gODtECH Steward" },
    "version": { "const": 1 },
    "root": { "type": "string", "minLength": 1 },
    "scannedFiles": { "type": "integer", "minimum": 0 },
    "textFiles": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "healthScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "git": { "$ref": "#/$defs/git" },
    "categoryCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "ruleCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "rulePacks": {
      "type": "array",
      "items": { "$ref": "#/$defs/rulePack" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule",
        "category",
        "severity",
        "message",
        "fixable",
        "confidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["repository", "security", "documentation", "code", "dependencies", "git", "configuration"]
        },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "fixable": { "type": "boolean" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "details": { "type": "string" },
        "remediation": { "type": "string" }
      }
    },
    "rulePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isRepository"],
      "properties": {
        "isRepository": { "type": "boolean" },
        "root": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" }
      }
    }
  }
}
